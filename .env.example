# Environment Configuration for CEDOI Ticketing Platform

# Node environment (development | test | production)
NODE_ENV=development

# Application URLs
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PORT=4000

# Database (PostgreSQL 18)
DATABASE_URL="postgresql://postgres:Postgres%40123@127.0.0.1:5432/cedoi_event_db?schema=public"

# Background Processing (Redis & BullMQ)
# When Redis is not running, durable Outbox Sweeper handles background tasks directly
REDIS_URL="redis://127.0.0.1:6379"

# Security & Secrets
# AUTH_SECRET must be at least 32 characters for cookie session encryption/signing
AUTH_SECRET="cedoi_secret_auth_session_key_min_32_characters_long_2026"
# TICKET_ENCRYPTION_KEY must be a 32-byte hex string (64 characters) for AES-256-GCM
TICKET_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Razorpay Test Gateway Keys (Replace with your registered test keys)
RAZORPAY_KEY_ID="rzp_test_cedoi123456"
RAZORPAY_KEY_SECRET="mock_secret_key_for_test_mode"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_cedoi_test"

# File Storage for PDF artifacts (local disk)
PDF_STORAGE_DIR="./storage/pdfs"
